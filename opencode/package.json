{
  "name": "opencode-orchestra",
  "version": "0.1.0",
  "description": "Orchestra — fast-flow fork of superpowers/mvp for OpenCode: brainstorm → growing task JSONL → parallel subagent delivery, OpenCode-native with file watcher and shared task protocol",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "agents",
    "scripts",
    "commands",
    "tools",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run copy-assets",
    "copy-assets": "node scripts/copy-assets.mjs",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "skills",
    "tdd",
    "orchestration",
    "parallel-agents",
    "task-jsonl",
    "worktree"
  ],
  "author": {
    "name": "droshima",
    "email": "dylan@example.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dylanOshima/orchestra.git"
  },
  "homepage": "https://github.com/dylanOshima/orchestra",
  "dependencies": {
    "@opencode-ai/plugin": "^1.18.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0",
    "bun-types": "latest"
  },
  "engines": {
    "node": ">=18"
  }
}
